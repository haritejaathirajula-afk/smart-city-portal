# =============================================================================
# SMART CITY SERVICE PORTAL - BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port and Runtime Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:5173

# MySQL 8 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smart_city_db

# Database Connection Pool Settings
DB_WAIT_FOR_CONNECTIONS=true
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# JSON Web Token (JWT) Security Secrets
# Change JWT_SECRET to a strong random key in production (minimum 32 characters)
JWT_SECRET=city_portal_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# File Upload Configuration (Multer)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880
